diff --git a/drivers/iio/frequency/adf5355.c b/drivers/iio/frequency/adf5355.c
index 78d256a..74efe4c 100644
--- a/drivers/iio/frequency/adf5355.c
+++ b/drivers/iio/frequency/adf5355.c
@@ -591,6 +591,8 @@ static ssize_t adf5355_write(struct iio_dev *indio_dev,
 		if (chan->channel == 0) {
 			st->regs[ADF5355_REG6] &= ~ADF5355_REG6_RF_OUT_EN(1);
 			st->regs[ADF5355_REG6] |= ADF5355_REG6_RF_OUT_EN(!!!readin);
+			if (gpio_is_valid(st->pdata->gpio_pdbrf))
+				gpio_set_value(st->pdata->gpio_pdbrf, !readin);
 		} else {
 			st->regs[ADF5355_REG6] &= ~(st->is_5355 ?
 				ADF5355_REG6_RF_OUTB_EN(1) :
@@ -753,6 +755,12 @@ static struct adf5355_platform_data *adf5355_parse_dt(struct device *dev)
 	else
 		pdata->gpio_lock_detect = ret;
 
+	ret = of_get_named_gpio(np, "adi,pdbrf-gpio", 0);
+	if (ret < 0)
+		pdata->gpio_pdbrf = -1;
+	else
+		pdata->gpio_pdbrf = ret;
+
 	pdata->ref_doubler_en = of_property_read_bool(np,
 			"adi,reference-doubler-enable");
 	pdata->ref_div2_en = of_property_read_bool(np,
@@ -964,6 +972,23 @@ static int adf5355_probe(struct spi_device *spi)
 		gpio_direction_input(pdata->gpio_lock_detect);
 	}
 
+	/*
+	 * PDBRF (RFOUTA power-down input, active low). The ADF5355 data
+	 * sheet requires this pin not to float; drive it high to enable
+	 * RFOUTA and keep it in sync with the "powerdown" attribute
+	 * (see adf5355_write()).
+	 */
+	if (gpio_is_valid(pdata->gpio_pdbrf)) {
+		ret = devm_gpio_request_one(&spi->dev, pdata->gpio_pdbrf,
+					    GPIOF_OUT_INIT_HIGH,
+					    "adf5355-pdbrf");
+		if (ret) {
+			dev_err(&spi->dev, "fail to request PDBRF GPIO-%d\n",
+				pdata->gpio_pdbrf);
+			pdata->gpio_pdbrf = -1;
+		}
+	}
+
 	if (pdata->power_up_frequency) {
 		ret = adf5355_set_freq(st, pdata->power_up_frequency, 0);
 		if (ret)
diff --git a/include/linux/iio/frequency/adf5355.h b/include/linux/iio/frequency/adf5355.h
index b19e32a..2cfad21 100644
--- a/include/linux/iio/frequency/adf5355.h
+++ b/include/linux/iio/frequency/adf5355.h
@@ -24,6 +24,10 @@
  * @gpio_lock_detect:	Optional, if set with a valid GPIO number,
  *			pll lock state is tested upon read.
  *			If not used - set to -1.
+ * @gpio_pdbrf:		Optional, if set with a valid GPIO number, the RFOUTA
+ *			power-down pin (PDBRF) is driven by software: high enables
+ *			RFOUTA, low powers it down.
+ *			If not used - set to -1.
  * @outa_en: 		Enables or disables the primary RF output
  * @outb_en: 		Enables or disables the auxiliary/high RF output
  * @outa_power:		Set the value of the primary RF output power level
@@ -80,6 +84,7 @@
 	u32			clock_shift;
 
  	int			gpio_lock_detect;
+	int			gpio_pdbrf;
  };
 
 #endif /* IIO_PLL_ADF5355_H_ */
