+++ b/arch/arm/boot/dts/adi-fmcomms5.dtsi
@@ -20,7 +20,7 @@
 		/* SPI Setup */
 		reg = <0>;
 		spi-cpha;
-		spi-max-frequency = <10000000>;
+		spi-max-frequency = <1000000>;
 
 		/* Clocks */
 		clocks = <&ad9361_clkin>;
@@ -39,7 +39,7 @@
 		adi,lvds-rx-onchip-termination-enable;
 
 		adi,rx-data-clock-delay = <0>;
-		adi,rx-data-delay = <9>;
+		adi,rx-data-delay = <4>;
 		adi,tx-fb-clock-delay = <4>;
 		adi,tx-data-delay = <0>;
 
@@ -244,7 +244,7 @@
 		/* SPI Setup */
 		reg = <1>;
 		spi-cpha;
-		spi-max-frequency = <10000000>;
+		spi-max-frequency = <1000000>;
 
 		/* Clocks */
 		clocks = <&ad9361_clkin>;
@@ -263,7 +263,7 @@
 		adi,lvds-rx-onchip-termination-enable;
 
 		adi,rx-data-clock-delay = <0>;
-		adi,rx-data-delay = <9>;
+		adi,rx-data-delay = <4>;
 		adi,tx-fb-clock-delay = <4>;
 		adi,tx-data-delay = <0>;
 
@@ -459,14 +459,4 @@
 	};
 };
 
-&fmc_i2c {
-	ad7291@2f {
-		compatible = "adi,ad7291";
-		reg = <0x2f>;
-	};
 
-	eeprom@50 {
-		compatible = "at24,24c02";
-		reg = <0x50>;
-	};
-};
diff --git a/arch/arm/boot/dts/zynq-zc706-adv7511-ad9361-fmcomms5-ext-lo-adf5355.dts b/arch/arm/boot/dts/zynq-zc706-adv7511-ad9361-fmcomms5-ext-lo-adf5355.dts
index 886ae61..971c511 100644
