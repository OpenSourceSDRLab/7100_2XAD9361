@@ -6,7 +6,7 @@
 
 	aliases: aliases {
 		ethernet0 = &gem0;
-		serial0 = &uart1;
+		serial0 = &uart0;
 	};
 };
 
@@ -23,7 +23,7 @@
 	dr_mode = "host"; /* This breaks OTG mode */
 };
 
-&uart1 {
+&uart0 {
 	status = "okay";
 };
 
