 			compatible = "xlnx,axi-iic-1.02.a", "xlnx,xps-iic-2.00.a";
 			reg = <0x41600000 0x10000>;
@@ -160,14 +160,14 @@
 
 			#sound-dai-cells = <0>;
 		};
-
+*/
 		axi_sysid_0: axi-sysid-0@45000000 {
 			compatible = "adi,axi-sysid-1.00.a";
