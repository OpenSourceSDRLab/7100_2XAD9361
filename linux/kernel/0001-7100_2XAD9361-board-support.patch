+++ b/arch/arm/boot/dts/zynq-zc706-adv7511-ad9361-fmcomms5-ext-lo-adf5355.dts
@@ -16,18 +16,18 @@
 		#clock-cells = <0>;
 		compatible = "adi,adf5355";
 		reg = <2>;
-		spi-max-frequency = <10000000>;
+		spi-max-frequency = <1000000>;
 		clocks = <&ad9361_clkin>;
 		clock-names = "clkin";
 		clock-output-names = "ADF5355";
 		gpios = <&gpio0 112 0>;
 		adi,charge-pump-current = <900>;
 		adi,muxout-select = <6>;
-//		adi,mute-till-lock-enable;
 		adi,output-a-power = <3>;
 		adi,output-b-power = <0>;
 		adi,charge-pump-negative-bleed-enable;
 		adi,reference-differential-input-enable;
+		adi,muxout-level-3v3-enable;
 		adi,power-up-frequency = /bits/ 64 <4800000000>;
 		adi,output-a-enable;
 		adi,clock-shift = <2>;
diff --git a/arch/arm/boot/dts/zynq-zc706-adv7511-ad9361-fmcomms5.dts b/arch/arm/boot/dts/zynq-zc706-adv7511-ad9361-fmcomms5.dts
